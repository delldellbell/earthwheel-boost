<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EarthwheelBoost" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ew_green</item>
        <item name="android:colorPrimaryDark">@color/ew_white</item>
        <item name="android:colorAccent">@color/ew_green</item>
        <item name="android:colorBackground">@color/ew_bg</item>
        <item name="android:windowBackground">@color/ew_bg</item>
        <item name="android:statusBarColor">@color/ew_white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/ew_bg</item>
        <item name="android:alertDialogTheme">@style/EW.Dialog</item>
    </style>

    <style name="EW.Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:colorAccent">@color/ew_green</item>
    </style>

    <style name="EW.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="EW.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="EW.CardTitle" parent="">
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ew_black</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
