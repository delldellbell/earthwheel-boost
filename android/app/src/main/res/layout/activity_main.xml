<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ew_bg"
    android:orientation="vertical">

    <!-- Antet cu logo -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ew_white"
        android:elevation="2dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Earthwheel"
            android:src="@drawable/logo_earthwheel" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvConn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_chip"
                android:elevation="1dp"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="●  Se pornește…"
                android:textColor="@color/ew_gray"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                style="@style/EW.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:padding="8dp">

                <ImageView
                    android:id="@+id/imgScooter"
                    android:layout_width="match_parent"
                    android:layout_height="210dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Scooter"
                    android:scaleType="fitCenter"
                    android:src="@drawable/scooter" />
            </LinearLayout>

            <!-- Butonul principal MELC / RACHETĂ -->
            <FrameLayout
                android:id="@+id/btnMode"
                android:layout_width="190dp"
                android:layout_height="190dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_disabled"
                android:clickable="true"
                android:elevation="10dp"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless">

                <TextView
                    android:id="@+id/tvEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="🐌"
                    android:textSize="86sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvModeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="MOD MELC"
                android:textColor="@color/ew_black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModeSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Așteaptă conexiunea"
                android:textColor="@color/ew_gray"
                android:textSize="15sp" />

            <!-- Securitate -->
            <LinearLayout
                style="@style/EW.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/EW.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔒  Securitate" />

                    <TextView
                        android:id="@+id/tvPinInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cod activ"
                        android:textColor="@color/ew_gray"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnChangePin"
                        style="@style/EW.Button"
                        android:text="Schimbă codul" />

                    <Button
                        android:id="@+id/btnRemovePin"
                        style="@style/EW.Button"
                        android:text="Scoate codul" />

                    <Button
                        android:id="@+id/btnEmail"
                        style="@style/EW.Button"
                        android:text="Email de recuperare" />

                    <Button
                        android:id="@+id/btnRecover"
                        style="@style/EW.Button"
                        android:text="Am uitat codul – trimite pe email" />

                    <Switch
                        android:id="@+id/swAppLock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Cere codul la deschiderea aplicației"
                        android:textColor="@color/ew_black" />
                </LinearLayout>
            </LinearLayout>

            <!-- Telecomandă RF -->
            <LinearLayout
                style="@style/EW.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/EW.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📡  Telecomandă RF" />

                    <TextView
                        android:id="@+id/tvRf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/ew_gray"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnRfLearn"
                        style="@style/EW.Button"
                        android:text="Asociază telecomanda" />

                    <Button
                        android:id="@+id/btnRfClear"
                        style="@style/EW.Button"
                        android:text="Șterge telecomanda" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnForget"
                style="@android:style/Widget.Material.Button.Borderless"
                android:textAllCaps="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:text="Asociază altă placă"
                android:textColor="@color/ew_gray" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:text="Earthwheel Boost · v1.0"
                android:textColor="#A0A8A5"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
